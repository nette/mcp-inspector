{
	"name": "nette/mcp-inspector",
	"description": "🔭 MCP server for Nette application introspection",
	"keywords": ["nette", "mcp", "model-context-protocol", "introspection", "di", "dependency-injection", "ai", "llm"],
	"homepage": "https://nette.org",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.3 - 8.5",
		"mcp/sdk": "^0.8",
		"nette/bootstrap": "^3.2.6",
		"nette/di": "^3.2.7",
		"nette/schema": "^1.3.6",
		"nette/utils": "^4.1"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Nette\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"archive": {
		"exclude": ["/vendor", "/tests", "/docs"]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"php-http/discovery": true,
			"phpstan/extension-installer": true
		}
	}
}
